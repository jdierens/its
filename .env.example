NEXT_PUBLIC_SUPABASE_URL=https://fxsbpreasbdalwthyzvk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Do not prefix these with NEXT_PUBLIC_.
# The service role key reads and writes QuickBooks tokens in qbo_connection
# and eBay tokens in ebay_connection.
SUPABASE_SERVICE_ROLE_KEY=

# QuickBooks Online. Server only. QBO_ENVIRONMENT is sandbox or production.
# Register QBO_REDIRECT_URI on the Intuit app. For local dev that is
# http://localhost:3000/api/qbo/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
QBO_ENVIRONMENT=sandbox

# eBay. Server only. EBAY_ENVIRONMENT is sandbox or production.
# EBAY_CLIENT_ID is the App ID. EBAY_CLIENT_SECRET is the Cert ID.
# EBAY_RU_NAME is the RuName from the eBay developer portal. OAuth sends that
# RuName as redirect_uri. The Auth Accepted URL behind the RuName is
# https://its-epks.vercel.app/api/ebay/callback
# EBAY_DEPLETION_VERIFICATION_TOKEN is the 32 to 80 character token you enter
# on the marketplace account deletion notification. Keep it server-only.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_ENVIRONMENT=sandbox
EBAY_DEPLETION_VERIFICATION_TOKEN=

# Update pricing uses EBAY_CLIENT_ID and EBAY_CLIENT_SECRET for an application
# token. It does not use the seller refresh token. Leave insights off until
# eBay approves Marketplace Insights. BrokerBin stays off until a key is set,
# and the provider does not call BrokerBin yet.
EBAY_INSIGHTS_ENABLED=
BROKERBIN_API_KEY=

# Google Sheets export. Server only. Do not prefix these with NEXT_PUBLIC_.
# GOOGLE_SERVICE_ACCOUNT_JSON is the full service account key file.
# GOOGLE_EXPORT_FOLDER_ID is the shared Drive folder id, or the folder URL.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_EXPORT_FOLDER_ID=

# Lens. Server only. GEMINI_API_KEY reads labels in photos. GEMINI_MODEL
# overrides the default gemini-3.8-flash. Do not prefix either with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=

# Sign-in gate. Server only. Exactly "true" requires a Google session.
# Leave unset until the Google OAuth client is configured. Any other value
# leaves the app open, with no login redirect and no app_users reads.
AUTH_REQUIRED=
