# QuickBooks Online. Server only. QBO_ENVIRONMENT is sandbox or production.
# Register QBO_REDIRECT_URI on the Intuit app. For local dev that is
# http://localhost:3000/api/qbo/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
QBO_ENVIRONMENT=sandbox
